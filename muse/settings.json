{
  "schema_version": 1,
  "provider": "meta",
  "model": "muse-wonder-full-1.0",
  "reasoning_effort": "max",
  "model_reasoning_efforts": {
    "muse-wonder-full-1.0": "max"
  },
  "tui": {
    "foreign_context_notice_shown": true
  },
  "mcpServers": {
    "blender": {
      "mode": "optional",
      "transport": "stdio",
      "command": "/Users/c/.local/bin/blender-mcp"
    },
    "cloudflare-api": {
      "mode": "optional",
      "transport": "streamable_http",
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "playwright": {
      "mode": "optional",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "xcode": {
      "mode": "optional",
      "command": "xcrun",
      "args": [
        "mcpbridge"
      ]
    }
  },
  "contributor_mode_enabled": true,
  "contributor_mode_disclosure_acknowledged": true
}